{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    // Core correctness rules (mirroring ESLint config)
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-restricted-imports": "error",

    // TypeScript rules
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],

    // React rules (when react plugin enabled)
    "react/exhaustive-deps": "error",
    "react/rules-of-hooks": "error"
  },
  "plugins": ["typescript", "react", "nextjs", "import"],
  "ignorePatterns": [
    ".next/**",
    ".build/**",
    "out/**",
    "build/**",
    "dist/**",
    "coverage/**",
    "node_modules/**",
    ".worktrees/**",
    ".claude/**",
    ".omnivscodeagent/**",
    "_tasks/**",
    ".agents/**",
    ".source/**",
    "vscode-extension/**",
    "_references/**",
    "_mono_repo/**",
    "docs/**",
    "open-sse/mcp-server/dist/**",
    "playwright-report/**",
    "test-results/**",
    "app/**",
    "app.__qa_backup/**",
    "clipr/**",
    "scripts/**",
    "bin/**"
  ]
}
