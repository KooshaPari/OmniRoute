{
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 120,
    "tabWidth": 2,
    "semi": true,
    "arrowParens": "always",
    "bracketSpacing": true,
    "plugins": [],
    "overrides": [
      { "files": "*.ts", "options": { "parser": "typescript" } },
      { "files": "*.tsx", "options": { "parser": "typescript" } }
    ]
  }
}
