{
  "name": "@omniroute/ffi",
  "version": "3.8.43",
  "description": "OmniRoute FFI — auto-discovers the prebuilt cdylib for the host platform via @omniroute/ffi-<platform> optionalDependency. Falls back to JITI-delayed TS path if no native crate is found.",
